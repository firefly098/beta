# Local SQLite is no longer used. Use Prisma Postgres / Vercel:
#   vercel env pull .env.local
# or paste DATABASE_URL from the Prisma / Vercel dashboard.

DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional — some Prisma Postgres setups also provide these:
# PRISMA_DATABASE_URL=
# POSTGRES_URL=

# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL="http://localhost:3000"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

# Optional — without this, uploads go to /public/uploads (not durable on Vercel)
# BLOB_READ_WRITE_TOKEN=
